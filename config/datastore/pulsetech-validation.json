"/* PulseTech ANC record: structural validation rules.\n   Datastore key: enable-emr-validation/pulsetech. Evaluated per record, before\n   the mapping. Structural checks only: the data model\n   itself (mandatory attributes, value types, ranges) is enforced by DHIS2.\n\n   Input:  body — one PulseTech record.\n   Output: { valid: boolean, missingFields: [string] }\n   valid=false becomes an HTTP 400 listing missingFields verbatim.\n\n   Each rule is one row in a table. To add a rule, add a row. */\n\n/* ---- helpers ----------------------------------------------------------- */\nlocal rec = if std.isObject(body) then body else {};\n// reads a field from an object, or null when the object or field is missing\nlocal get(o, f) = if std.isObject(o) && std.objectHas(o, f) then o[f] else null;\n// a value counts as present unless it is null or a blank string\nlocal present(v) = v != null && !(std.isString(v) && std.length(std.stripChars(v, ' \\t')) == 0);\n// the follow-up entries, ignoring anything that is not an object\nlocal followups = local f = get(rec, 'anc_followup');\n                  if std.isArray(f) then [x for x in f if std.isObject(x)] else [];\n\n/* ---- record-level rules -------------------------------------------------- */\n// names (pnt_fname, pnt_mname, pnt_lname) are optional: mapped when sent, dropped when not\nlocal recordRules = [\n  { field: f, ok: present(get(rec, f)) }\n  for f in [\n    'pnt_mrn', 'pnt_date_birth', 'pnt_phone',\n    'facility_dhis2_org_unit_code',\n  ]\n];\n\n/* ---- per-follow-up rules -------------------------------------------------- */\nlocal followupRules =\n  if std.length(followups) == 0 then [{ field: 'anc_followup (at least one entry)', ok: false }]\n  else std.flattenArrays([\n    [\n      { field: 'anc_followup[%d].%s' % [i, f], ok: present(get(followups[i], f)) }\n      for f in ['followup_date', 'lmp_date', 'edd', 'ga', 'visit_number']\n    ]\n    for i in std.range(0, std.length(followups) - 1)\n  ]);\n\n/* ---- verdict ------------------------------------------------------------ */\nlocal missing = [r.field for r in recordRules + followupRules if !r.ok];\n{\n  valid: std.length(missing) == 0,\n  missingFields: missing,\n  // who the verdict is about; surfaces in the 400 (null when the id is missing)\n  mrn: if present(get(rec, 'pnt_mrn')) then std.toString(get(rec, 'pnt_mrn')) else null,\n}\n"
