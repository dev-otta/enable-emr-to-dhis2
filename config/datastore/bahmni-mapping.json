"/* Bahmni ANC record -> DHIS2 tracker payload.\n   Datastore key: enable-emr-mapping/bahmni. A pure function of one person\n   record (the shape Bahmni exports per woman): no variables, no lookups.\n\n   Emits NO trackedEntity/enrollment/event UIDs — DHIS2 owns identifiers; the\n   mediator looks the woman up by the identity attribute after mapping and\n   injects her existing UIDs so a re-push updates instead of duplicating.\n\n   Org units carry the facility's DHIS2 org-unit CODE verbatim (the import runs\n   with orgUnitIdScheme=CODE). UIDs verified against db-dump/db-dump.sql.gz. */\n\n/* ---- DHIS2 metadata ----------------------------------------------------- */\nlocal PROGRAM = 'WSGAb5XwJ3Y';              // ANC - RMNCAH - Antenatal care registry\nlocal TRACKED_ENTITY_TYPE = 'MCPQUTHX1Ze';  // Person\nlocal STAGE = {\n  profile: 'iF5roNU7QWm',  // Woman's Profile and History (NON-repeatable)\n  exam: 'JqW7c9HYjVr',     // ANC Examination (repeatable)\n};\nlocal ATTRIBUTE = {\n  mrn: 'OYuDdqr2MvX',          // Client MRN (unique — the identity key)\n  dateOfBirth: 'Fgf497oYvSC',\n  phone: 'RJxLa3nITB3',        // SMS phone number\n};\nlocal DATA_ELEMENT = {\n  lnmp: 'w4ky6EkVahL',\n  edd: 'Ru01omP2WCQ',\n  gestationalAge: 'w9p8MQDRyMr',  // sent verbatim from the registration encounter\n  gaSource: 'RPSgZF1i0hk',        // option set: Clinical | LMP | Ultrasound\n  visitNumber: 'bXVD2EMF7UW',     // ANC Visit Number — the event MERGE KEY\n};\n\n/* ---- helpers ------------------------------------------------------------- */\nlocal present(v) = v != null && v != '';\nlocal attribute(uid, value) = { attribute: uid, value: value };\nlocal dataValue(uid, value) = { dataElement: uid, value: value };\n// picks the first value in a list that is not null (patient-level fields like\n// dateOfFirstVisit can arrive on any of the woman's encounters)\nlocal firstNonNull(xs) = local hits = [x for x in xs if x != null];\n                         if std.length(hits) > 0 then hits[0] else null;\n\n/* ---- the record ----------------------------------------------------------- */\nlocal rec = body;\nlocal orgUnit = rec.facilityCode;\nlocal encounters = std.sort(rec.encounters, function(e) e.visitNumber);\nlocal lastEncounter = encounters[std.length(encounters) - 1];\n\n/* enrollment anchor: the recorded first-visit date, else the earliest encounter */\nlocal enrolledAt = local d = firstNonNull([e.dateOfFirstVisit for e in encounters]);\n                   if d != null then d else encounters[0].encounterDate;\n\n/* ---- events ---------------------------------------------------------------- */\n/* Woman's Profile: one per pregnancy — built from the encounter that carries\n   the registration data (LNMP + EDD). A follow-up-only record has no such\n   encounter and leaves the existing profile untouched. */\nlocal registrations = [e for e in encounters if present(e.LNMP) && present(e.EDD)];\nlocal profileEvents = [\n  {\n    programStage: STAGE.profile,\n    orgUnit: orgUnit,\n    occurredAt: enrolledAt,\n    status: 'COMPLETED',\n    completedAt: enrolledAt,\n    dataValues:\n      [\n        dataValue(DATA_ELEMENT.lnmp, r.LNMP),\n        dataValue(DATA_ELEMENT.edd, r.EDD),\n      ]\n      // GA is mapped verbatim; validation guarantees it on a registration\n      // encounter, and the defensive omit keeps a null from ever being sent\n      + (if present(r.gestationalAge) then [\n           dataValue(DATA_ELEMENT.gestationalAge, r.gestationalAge),\n           dataValue(DATA_ELEMENT.gaSource, 'LMP'),\n         ] else []),\n  }\n  for r in (if std.length(registrations) > 0 then [registrations[0]] else [])\n];\n\n/* one exam event per encounter; the visit number is the merge key.\n   A visit captured in the source IS a completed contact — COMPLETED, dated\n   the day it happened. (Only the SCHEDULE placeholder below stays open: it is\n   what the overdue-visit tracking keys off.) */\nlocal examEvent(e) = {\n  programStage: STAGE.exam,\n  orgUnit: orgUnit,\n  occurredAt: e.encounterDate,\n  status: 'COMPLETED',\n  completedAt: e.encounterDate,\n  dataValues: [dataValue(DATA_ELEMENT.visitNumber, e.visitNumber)],\n};\n\n/* the next appointment: ONE SCHEDULE event from the LATEST encounter's\n   nextDate. It carries NO data values — DHIS2 forbids them on SCHEDULE events\n   (E1315) — so it has no visit number. The merge instead claims the stage's\n   open SCHEDULE event when a real visit arrives: attendance fulfils the\n   appointment and the placeholder BECOMES the visit. */\nlocal scheduledEvents =\n  if present(lastEncounter.nextDate) then [{\n    programStage: STAGE.exam,\n    orgUnit: orgUnit,\n    scheduledAt: lastEncounter.nextDate,\n    status: 'SCHEDULE',\n  }] else [];\n\n/* ---- the tracker payload ---------------------------------------------------- */\n{\n  trackedEntities: [\n    {\n      trackedEntityType: TRACKED_ENTITY_TYPE,\n      orgUnit: orgUnit,\n      attributes: [\n        attribute(ATTRIBUTE.mrn, std.toString(rec.patientId)),\n        attribute(ATTRIBUTE.dateOfBirth, rec.birthDate),\n      ] + (\n        // defensive: validation requires the phone, but never send a null value\n        if present(rec.phoneNumber) then [attribute(ATTRIBUTE.phone, rec.phoneNumber)] else []\n      ),\n      enrollments: [\n        {\n          program: PROGRAM,\n          orgUnit: orgUnit,\n          enrolledAt: enrolledAt,\n          occurredAt: enrolledAt,\n          status: 'ACTIVE',\n          events: profileEvents + [examEvent(e) for e in encounters] + scheduledEvents,\n        },\n      ],\n    },\n  ],\n}\n"
