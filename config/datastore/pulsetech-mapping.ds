/* PulseTech ANC record -> DHIS2 tracker payload.
   Datastore key: enable-emr-mapping/pulsetech. a pure function of one record.

   mediator looks the woman up by MRN + program after mapping and injects her
   existing UIDs so a re-push updates instead of duplicating. */

/* ---- DHIS2 metadata ----------------------------------------------------- */
local PROGRAM = 'WSGAb5XwJ3Y';              // ANC - RMNCAH - Antenatal care registry
local TRACKED_ENTITY_TYPE = 'MCPQUTHX1Ze';  // Person
local STAGE = {
  profile: 'iF5roNU7QWm',  // Woman's Profile and History (NON-repeatable)
  exam: 'JqW7c9HYjVr',     // ANC Examination (repeatable)
};
local ATTRIBUTE = {
  mrn: 'OYuDdqr2MvX',              // identity key, stored as '<facility code>-<MRN>'
                                   // (MRNs are only unique within one facility)
  firstName: 'sB1IHYu2xQT',        // optional
  fathersName: 'ZtQqOYot5ut',      // optional 
  grandfathersName: 'ENRjVGxVL6l', // optional
  dateOfBirth: 'Fgf497oYvSC',
  ageYears: 'B6TnnFMgmCk',         // Age (years) — for exports that carry age, not DOB
  phone: 'RJxLa3nITB3',            // SMS phone number
};
local DATA_ELEMENT = {
  lnmp: 'w4ky6EkVahL',
  edd: 'Ru01omP2WCQ',
  gestationalAge: 'w9p8MQDRyMr',  // INTEGER_POSITIVE, compulsory on the profile
  gaSource: 'RPSgZF1i0hk',        // option set: Clinical | LMP | Ultrasound
  visitNumber: 'bXVD2EMF7UW',     // ANC Visit Number — the event MERGE KEY
};

/* ---- helpers ------------------------------------------------------------- */
local attribute(uid, value) = { attribute: uid, value: value };
local dataValue(uid, value) = { dataElement: uid, value: value };
// an attribute/data value that is only included when the source sent a value
local optionalAttribute(uid, value) = if value == null then [] else [attribute(uid, value)];
local optionalDataValue(uid, value) = if value == null then [] else [dataValue(uid, value)];
local get(o, f) = if std.objectHas(o, f) then o[f] else null;

/* "Visit 3" -> 3 (tolerates a bare number too) */
local visitNo(raw) =
  if std.isNumber(raw) then raw
  else (
    local parts = std.split(std.toString(raw), ' ');
    std.parseInt(parts[std.length(parts) - 1])
  );

/* ---- the record ----------------------------------------------------------- */
local rec = body;
// reads a field from the record, or null when it is missing
local field(name) = if std.objectHas(rec, name) then rec[name] else null;
local orgUnit = rec.facility_dhis2_org_unit_code;
local followups = std.sort(rec.anc_followup, function(f) f.followup_date);
local first = followups[0];  // the registration visit anchors the enrollment

/* ---- events ---------------------------------------------------------------- */
/* captured contacts are COMPLETED, dated the day they happened (PulseTech is missing a
  scheduled-visit concept. For now, every event it sends is marked as completed). */
// LMP/EDD are optional: sent when recorded, dropped when not. GA source is
// 'LMP' when the export carries an LNMP (in the Akaki data, GA matches
// weeks-since-LNMP for 92% of such rows within a week — it IS LMP-derived)
// and omitted otherwise: without an LNMP the export carries no source signal,
// and the mediator never guesses one.
local lmp = get(first, 'lmp_date');
local profileEvent = {
  programStage: STAGE.profile,
  orgUnit: orgUnit,
  occurredAt: first.followup_date,
  status: 'COMPLETED',
  completedAt: first.followup_date,
  dataValues:
    optionalDataValue(DATA_ELEMENT.lnmp, lmp)
    + optionalDataValue(DATA_ELEMENT.edd, get(first, 'edd'))
    + [dataValue(DATA_ELEMENT.gestationalAge, std.parseInt(first.ga))]
    + optionalDataValue(DATA_ELEMENT.gaSource, if lmp == null then null else 'LMP'),
};

local examEvent(f) = {
  programStage: STAGE.exam,
  orgUnit: orgUnit,
  occurredAt: f.followup_date,
  status: 'COMPLETED',
  completedAt: f.followup_date,
  dataValues: [dataValue(DATA_ELEMENT.visitNumber, visitNo(f.visit_number))],
};

/* ---- the tracker payload ---------------------------------------------------- */
{
  trackedEntities: [
    {
      trackedEntityType: TRACKED_ENTITY_TYPE,
      orgUnit: orgUnit,
      attributes: [attribute(ATTRIBUTE.mrn, orgUnit + '-' + std.toString(rec.pnt_mrn))]
      // DOB and age are optional: PulseTech exports age in years, not a DOB
      + optionalAttribute(ATTRIBUTE.dateOfBirth, field('pnt_date_birth'))
      + [attribute(ATTRIBUTE.phone, rec.pnt_phone)]
      + optionalAttribute(ATTRIBUTE.ageYears, field('pnt_age'))
      // names are optional: mapped when the export includes them, dropped when not
      + optionalAttribute(ATTRIBUTE.firstName, field('pnt_fname'))
      + optionalAttribute(ATTRIBUTE.fathersName, field('pnt_mname'))
      + optionalAttribute(ATTRIBUTE.grandfathersName, field('pnt_lname')),
      enrollments: [
        {
          program: PROGRAM,
          orgUnit: orgUnit,
          enrolledAt: first.followup_date,
          occurredAt: first.followup_date,
          status: 'ACTIVE',
          events: [profileEvent] + [examEvent(f) for f in followups],
        },
      ],
    },
  ],
}
