"/* Bahmni ANC record — structural validation rules.\n   Datastore key: enable-emr-validation/bahmni. Evaluated per woman, before the mapping.\n\n   Input:  one per-woman record (see emr-mocks/bahmni/anc-record.json);\n           may be arbitrarily malformed, so every access is guarded.\n   Output: { valid: boolean, missingFields: [string] }\n   valid=false becomes an HTTP 400 (single) / an invalid entry (batch), listing\n   missingFields verbatim.\n\n   Configuration: Each rule is one row in a table. To add a rule, add a row. */\n\n/* ---- helpers ----------------------------------------------------------- */\nlocal rec = if std.isObject(body) then body else {};\n// reads a field from an object, or null when the object or field is missing\nlocal get(o, f) = if std.isObject(o) && std.objectHas(o, f) then o[f] else null;\n// a value counts as present unless it is null or a blank string\nlocal present(v) = v != null && !(std.isString(v) && std.length(std.stripChars(v, ' \\t')) == 0);\n\nlocal visits = local v = get(rec, 'visits');\n               if std.isArray(v) then [x for x in v if std.isObject(x)] else [];\nlocal hasVisitOne = std.length([v for v in visits if get(v, 'visitNumber') == 1]) > 0;\n\n/* ---- record-level rules (policy decisions are visible as rows) --------- */\nlocal recordRules = [\n  { field: 'patientId',    ok: present(get(rec, 'patientId')) },\n  { field: 'birthDate',    ok: present(get(rec, 'birthDate')) },\n  { field: 'facilityCode', ok: present(get(rec, 'facilityCode')) },\n  { field: 'phoneNumber',  ok: present(get(rec, 'phoneNumber')) },   // the SMS programme depends on it\n  // lnmp/edd/GA feed the profile, which is only built with visit 1\n  { field: 'lnmp (required with visit 1)', ok: !hasVisitOne || present(get(rec, 'lnmp')) },\n  { field: 'edd (required with visit 1)',  ok: !hasVisitOne || present(get(rec, 'edd')) },\n  { field: 'visits[].gestationalAge (required on visit 1)',\n    ok: std.length([v for v in visits if get(v, 'visitNumber') == 1 && !present(get(v, 'gestationalAge'))]) == 0 },\n];\n\n/* ---- per-visit rules ---------------------------------------------------- */\nlocal visitRules =\n  if std.length(visits) == 0 then [{ field: 'visits (at least one encounter)', ok: false }]\n  else std.flattenArrays([\n    [\n      { field: 'visits[%d].encounterDate' % i, ok: present(get(visits[i], 'encounterDate')) },\n      { field: 'visits[%d].visitNumber' % i,   ok: std.isNumber(get(visits[i], 'visitNumber')) },\n    ]\n    for i in std.range(0, std.length(visits) - 1)\n  ]);\n\n/* ---- verdict ------------------------------------------------------------ */\nlocal missing = [r.field for r in recordRules + visitRules if !r.ok];\n{\n  valid: std.length(missing) == 0,\n  missingFields: missing,\n  // who the verdict is about; surfaces in the 400 (null when the id is missing)\n  mrn: if present(get(rec, 'patientId')) then std.toString(get(rec, 'patientId')) else null,\n}\n"
