/* Bahmni batch envelope — datastore key: enable-emr-envelope/bahmni
   Bahmni exports a FLAT LIST OF ENCOUNTERS (several rows per woman, keyed by
   patientId). Fold it into ONE RECORD PER WOMAN so validation and mapping
   always see the same per-woman shape as the single-record endpoint.

   Input:  the request body — a bare array of encounters (or {"records":[...]}).
   Output: [record] — per-woman records, in order of first appearance. */

/* ---- helpers ---------------------------------------------------------- */
// reads a field from an object, or null when the object or field is missing
local get(o, f) = if std.isObject(o) && std.objectHas(o, f) then o[f] else null;
// picks the first value in a list that is not null (used to hoist patient
// fields: any of a woman's rows may carry them)
local firstNonNull(xs) = local hits = [x for x in xs if x != null];
                         if std.length(hits) > 0 then hits[0] else null;
// a row's visit number, for sorting; rows without one sort first
local visitNo(e) = local n = get(e, 'visitNumber'); if std.isNumber(n) then n else 0;

/* ---- the encounters --------------------------------------------------- */
local raw = if std.isArray(body) then body else get(body, 'records');
local encounters = if std.isArray(raw) then [e for e in raw if std.isObject(e)] else [];
local idOf(e) = std.toString(get(e, 'patientId'));

/* woman ids, in order of first appearance (keeps batch results readable) */
local ids = std.foldl(
  function(acc, e) if std.member(acc, idOf(e)) then acc else acc + [idOf(e)],
  encounters, []);

/* ---- one record per woman --------------------------------------------- */
local record(id) =
  local rows = std.sort([e for e in encounters if idOf(e) == id], visitNo);
  local hoist(f) = firstNonNull([get(e, f) for e in rows]);
  {
    patientId: get(rows[0], 'patientId'),
    birthDate: hoist('birthDate'),
    phoneNumber: hoist('phoneNumber'),        // first non-null: a later visit can supply it
    facilityCode: hoist('facilityCode'),
    dateOfFirstVisit: hoist('dateOfFirstVisit'),
    lnmp: hoist('lnmp'),
    edd: hoist('edd'),
    visits: [
      {
        encounterId: get(e, 'encounterId'),
        encounterDate: get(e, 'encounterDate'),
        visitNumber: get(e, 'visitNumber'),
        gestationalAge: get(e, 'gestationalAge'),
        nextDate: get(e, 'nextDate'),
      }
      for e in rows
    ],
  };

[record(id) for id in ids]
