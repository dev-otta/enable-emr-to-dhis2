"/* Bahmni batch envelope — datastore key: enable-emr-envelope/bahmni\n   Bahmni exports a FLAT LIST OF ENCOUNTERS (several rows per woman, keyed by\n   patientId). Fold it into ONE RECORD PER WOMAN so validation and mapping\n   always see the same per-woman shape as the single-record endpoint.\n\n   Input:  the request body — a bare array of encounters (or {\"records\":[...]}).\n   Output: [record] — per-woman records, in order of first appearance. */\n\n/* ---- helpers ---------------------------------------------------------- */\n// reads a field from an object, or null when the object or field is missing\nlocal get(o, f) = if std.isObject(o) && std.objectHas(o, f) then o[f] else null;\n// picks the first value in a list that is not null (used to hoist patient\n// fields: any of a woman's rows may carry them)\nlocal firstNonNull(xs) = local hits = [x for x in xs if x != null];\n                         if std.length(hits) > 0 then hits[0] else null;\n// a row's visit number, for sorting; rows without one sort first\nlocal visitNo(e) = local n = get(e, 'visitNumber'); if std.isNumber(n) then n else 0;\n\n/* ---- the encounters --------------------------------------------------- */\nlocal raw = if std.isArray(body) then body else get(body, 'records');\nlocal encounters = if std.isArray(raw) then [e for e in raw if std.isObject(e)] else [];\nlocal idOf(e) = std.toString(get(e, 'patientId'));\n\n/* woman ids, in order of first appearance (keeps batch results readable) */\nlocal ids = std.foldl(\n  function(acc, e) if std.member(acc, idOf(e)) then acc else acc + [idOf(e)],\n  encounters, []);\n\n/* ---- one record per woman --------------------------------------------- */\nlocal record(id) =\n  local rows = std.sort([e for e in encounters if idOf(e) == id], visitNo);\n  local hoist(f) = firstNonNull([get(e, f) for e in rows]);\n  {\n    patientId: get(rows[0], 'patientId'),\n    birthDate: hoist('birthDate'),\n    phoneNumber: hoist('phoneNumber'),        // first non-null: a later visit can supply it\n    facilityCode: hoist('facilityCode'),\n    dateOfFirstVisit: hoist('dateOfFirstVisit'),\n    lnmp: hoist('lnmp'),\n    edd: hoist('edd'),\n    visits: [\n      {\n        encounterId: get(e, 'encounterId'),\n        encounterDate: get(e, 'encounterDate'),\n        visitNumber: get(e, 'visitNumber'),\n        gestationalAge: get(e, 'gestationalAge'),\n        nextDate: get(e, 'nextDate'),\n      }\n      for e in rows\n    ],\n  };\n\n[record(id) for id in ids]\n"
