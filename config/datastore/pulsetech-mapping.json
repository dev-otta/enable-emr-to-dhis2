"/* PulseTech ANC record -> DHIS2 tracker payload.\n   Datastore key: enable-emr-mapping/pulsetech. a pure function of one record.\n\n   mediator looks the woman up by MRN + program after mapping and injects her\n   existing UIDs so a re-push updates instead of duplicating. */\n\n/* ---- DHIS2 metadata ----------------------------------------------------- */\nlocal PROGRAM = 'WSGAb5XwJ3Y';              // ANC - RMNCAH - Antenatal care registry\nlocal TRACKED_ENTITY_TYPE = 'MCPQUTHX1Ze';  // Person\nlocal STAGE = {\n  profile: 'iF5roNU7QWm',  // Woman's Profile and History (NON-repeatable)\n  exam: 'JqW7c9HYjVr',     // ANC Examination (repeatable)\n};\nlocal ATTRIBUTE = {\n  mrn: 'OYuDdqr2MvX',              // Client MRN (unique — the identity key)\n  firstName: 'sB1IHYu2xQT',        // optional\n  fathersName: 'ZtQqOYot5ut',      // optional \n  grandfathersName: 'ENRjVGxVL6l', // optional\n  dateOfBirth: 'Fgf497oYvSC',\n  phone: 'RJxLa3nITB3',            // SMS phone number\n};\nlocal DATA_ELEMENT = {\n  lnmp: 'w4ky6EkVahL',\n  edd: 'Ru01omP2WCQ',\n  gestationalAge: 'w9p8MQDRyMr',  // INTEGER_POSITIVE, compulsory on the profile\n  gaSource: 'RPSgZF1i0hk',        // option set: Clinical | LMP | Ultrasound\n  visitNumber: 'bXVD2EMF7UW',     // ANC Visit Number — the event MERGE KEY\n};\n\n/* ---- helpers ------------------------------------------------------------- */\nlocal attribute(uid, value) = { attribute: uid, value: value };\nlocal dataValue(uid, value) = { dataElement: uid, value: value };\n// an attribute that is only included when the source sent a value\nlocal optionalAttribute(uid, value) = if value == null then [] else [attribute(uid, value)];\n\n/* \"Visit 3\" -> 3 (tolerates a bare number too) */\nlocal visitNo(raw) =\n  if std.isNumber(raw) then raw\n  else (\n    local parts = std.split(std.toString(raw), ' ');\n    std.parseInt(parts[std.length(parts) - 1])\n  );\n\n/* ---- the record ----------------------------------------------------------- */\nlocal rec = body;\n// reads a field from the record, or null when it is missing\nlocal field(name) = if std.objectHas(rec, name) then rec[name] else null;\nlocal orgUnit = rec.facility_dhis2_org_unit_code;\nlocal followups = std.sort(rec.anc_followup, function(f) f.followup_date);\nlocal first = followups[0];  // the registration visit anchors the enrollment\n\n/* ---- events ---------------------------------------------------------------- */\n/* captured contacts are COMPLETED, dated the day they happened (PulseTech is missing a\n  scheduled-visit concept. For now, every event it sends is marked as completed). */\nlocal profileEvent = {\n  programStage: STAGE.profile,\n  orgUnit: orgUnit,\n  occurredAt: first.followup_date,\n  status: 'COMPLETED',\n  completedAt: first.followup_date,\n  dataValues: [\n    dataValue(DATA_ELEMENT.lnmp, first.lmp_date),\n    dataValue(DATA_ELEMENT.edd, first.edd),\n    dataValue(DATA_ELEMENT.gestationalAge, std.parseInt(first.ga)),\n    dataValue(DATA_ELEMENT.gaSource, 'LMP'),\n  ],\n};\n\nlocal examEvent(f) = {\n  programStage: STAGE.exam,\n  orgUnit: orgUnit,\n  occurredAt: f.followup_date,\n  status: 'COMPLETED',\n  completedAt: f.followup_date,\n  dataValues: [dataValue(DATA_ELEMENT.visitNumber, visitNo(f.visit_number))],\n};\n\n/* ---- the tracker payload ---------------------------------------------------- */\n{\n  trackedEntities: [\n    {\n      trackedEntityType: TRACKED_ENTITY_TYPE,\n      orgUnit: orgUnit,\n      attributes: [\n        attribute(ATTRIBUTE.mrn, rec.pnt_mrn),\n        attribute(ATTRIBUTE.dateOfBirth, rec.pnt_date_birth),\n        attribute(ATTRIBUTE.phone, rec.pnt_phone),\n      ]\n      // names are optional: mapped when the export includes them, dropped when not\n      + optionalAttribute(ATTRIBUTE.firstName, field('pnt_fname'))\n      + optionalAttribute(ATTRIBUTE.fathersName, field('pnt_mname'))\n      + optionalAttribute(ATTRIBUTE.grandfathersName, field('pnt_lname')),\n      enrollments: [\n        {\n          program: PROGRAM,\n          orgUnit: orgUnit,\n          enrolledAt: first.followup_date,\n          occurredAt: first.followup_date,\n          status: 'ACTIVE',\n          events: [profileEvent] + [examEvent(f) for f in followups],\n        },\n      ],\n    },\n  ],\n}\n"
