"/* Bahmni ANC record — structural validation rules.\n   Datastore key: enable-emr-validation/bahmni. Evaluated per woman, before the mapping.\n\n   Input:  one person record (see emr-mocks/bahmni/anc-record.json);\n           may be arbitrarily malformed, so every access is guarded.\n   Output: { valid: boolean, missingFields: [string], mrn: string|null }\n   valid=false becomes an HTTP 400 (single) / an invalid entry (batch), listing\n   missingFields verbatim.\n\n   Configuration: each rule is one row in a table. To add a rule, add a row. */\n\n/* ---- helpers ----------------------------------------------------------- */\nlocal rec = if std.isObject(body) then body else {};\n// reads a field from an object, or null when the object or field is missing\nlocal get(o, f) = if std.isObject(o) && std.objectHas(o, f) then o[f] else null;\n// a value counts as present unless it is null or a blank string\nlocal present(v) = v != null && !(std.isString(v) && std.length(std.stripChars(v, ' \\t')) == 0);\n// the encounter entries, ignoring anything that is not an object\nlocal encounters = local e = get(rec, 'encounters');\n                   if std.isArray(e) then [x for x in e if std.isObject(x)] else [];\n// an encounter that carries LNMP or EDD is the woman's registration data and\n// feeds the profile — on such an encounter the whole set must be present\nlocal isRegistration(e) = present(get(e, 'LNMP')) || present(get(e, 'EDD'));\n\n/* ---- record-level rules ------------------------------------------------- */\nlocal recordRules = [\n  { field: 'patientId',    ok: present(get(rec, 'patientId')) },\n  { field: 'birthDate',    ok: present(get(rec, 'birthDate')) },\n  { field: 'facilityCode', ok: present(get(rec, 'facilityCode')) },\n  { field: 'phoneNumber',  ok: present(get(rec, 'phoneNumber')) },   // the SMS programme depends on it\n];\n\n/* ---- per-encounter rules ------------------------------------------------- */\nlocal encounterRules =\n  if std.length(encounters) == 0 then [{ field: 'encounters (at least one entry)', ok: false }]\n  else std.flattenArrays([\n    [\n      { field: 'encounters[%d].encounterDate' % i, ok: present(get(encounters[i], 'encounterDate')) },\n      { field: 'encounters[%d].visitNumber' % i,   ok: std.isNumber(get(encounters[i], 'visitNumber')) },\n    ]\n    // LNMP, EDD and gestationalAge arrive together on the registration\n    // encounter, or not at all (a follow-up-only record builds no profile)\n    + (if isRegistration(encounters[i]) then [\n        { field: 'encounters[%d].LNMP (required with EDD)' % i, ok: present(get(encounters[i], 'LNMP')) },\n        { field: 'encounters[%d].EDD (required with LNMP)' % i, ok: present(get(encounters[i], 'EDD')) },\n        { field: 'encounters[%d].gestationalAge (required with LNMP/EDD)' % i,\n          ok: present(get(encounters[i], 'gestationalAge')) },\n      ] else [])\n    for i in std.range(0, std.length(encounters) - 1)\n  ]);\n\n/* ---- verdict ------------------------------------------------------------ */\nlocal missing = [r.field for r in recordRules + encounterRules if !r.ok];\n{\n  valid: std.length(missing) == 0,\n  missingFields: missing,\n  // who the verdict is about; surfaces in the 400 (null when the id is missing)\n  mrn: if present(get(rec, 'patientId')) then std.toString(get(rec, 'patientId')) else null,\n}\n"
