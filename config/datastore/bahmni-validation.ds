/* Bahmni ANC record — structural validation rules.
   Datastore key: enable-emr-validation/bahmni. Evaluated per woman, before the mapping.

   Input:  one person record (see emr-mocks/bahmni/anc-record.json);
           may be arbitrarily malformed, so every access is guarded.
   Output: { valid: boolean, missingFields: [string], mrn: string|null }
   valid=false becomes an HTTP 400 (single) / an invalid entry (batch), listing
   missingFields verbatim.

   Configuration: each rule is one row in a table. To add a rule, add a row. */

/* ---- helpers ----------------------------------------------------------- */
local rec = if std.isObject(body) then body else {};
// reads a field from an object, or null when the object or field is missing
local get(o, f) = if std.isObject(o) && std.objectHas(o, f) then o[f] else null;
// a value counts as present unless it is null or a blank string
local present(v) = v != null && !(std.isString(v) && std.length(std.stripChars(v, ' \t')) == 0);
// the encounter entries, ignoring anything that is not an object
local encounters = local e = get(rec, 'encounters');
                   if std.isArray(e) then [x for x in e if std.isObject(x)] else [];
// an encounter that carries LNMP or EDD is the woman's registration data and
// feeds the profile — on such an encounter the whole set must be present
local isRegistration(e) = present(get(e, 'LNMP')) || present(get(e, 'EDD'));

/* ---- record-level rules ------------------------------------------------- */
local recordRules = [
  { field: 'patientId',    ok: present(get(rec, 'patientId')) },
  { field: 'birthDate',    ok: present(get(rec, 'birthDate')) },
  { field: 'facilityCode', ok: present(get(rec, 'facilityCode')) },
  { field: 'phoneNumber',  ok: present(get(rec, 'phoneNumber')) },   // the SMS programme depends on it
];

/* ---- per-encounter rules ------------------------------------------------- */
local encounterRules =
  if std.length(encounters) == 0 then [{ field: 'encounters (at least one entry)', ok: false }]
  else std.flattenArrays([
    [
      { field: 'encounters[%d].encounterDate' % i, ok: present(get(encounters[i], 'encounterDate')) },
      { field: 'encounters[%d].visitNumber' % i,   ok: std.isNumber(get(encounters[i], 'visitNumber')) },
    ]
    // LNMP, EDD and gestationalAge arrive together on the registration
    // encounter, or not at all (a follow-up-only record builds no profile)
    + (if isRegistration(encounters[i]) then [
        { field: 'encounters[%d].LNMP (required with EDD)' % i, ok: present(get(encounters[i], 'LNMP')) },
        { field: 'encounters[%d].EDD (required with LNMP)' % i, ok: present(get(encounters[i], 'EDD')) },
        { field: 'encounters[%d].gestationalAge (required with LNMP/EDD)' % i,
          ok: present(get(encounters[i], 'gestationalAge')) },
      ] else [])
    for i in std.range(0, std.length(encounters) - 1)
  ]);

/* ---- verdict ------------------------------------------------------------ */
local missing = [r.field for r in recordRules + encounterRules if !r.ok];
{
  valid: std.length(missing) == 0,
  missingFields: missing,
  // who the verdict is about; surfaces in the 400 (null when the id is missing)
  mrn: if present(get(rec, 'patientId')) then std.toString(get(rec, 'patientId')) else null,
}
