"/* Bahmni ANC record -> DHIS2 tracker payload.\n   Datastore key: enable-emr-mapping/bahmni. A PURE FUNCTION of one per-woman\n   record (the shape the envelope expression produces): no variables, no lookups.\n\n   Emits NO trackedEntity/enrollment/event UIDs — DHIS2 owns identifiers; the\n   mediator looks the woman up by MRN + program after mapping and injects her\n   existing UIDs so a re-push updates instead of duplicating.\n\n   Org units carry the facility's DHIS2 org-unit CODE verbatim (the import runs\n   with orgUnitIdScheme=CODE). UIDs verified against db-dump/db-dump.sql.gz. */\n\n/* ---- DHIS2 metadata ----------------------------------------------------- */\nlocal PROGRAM = 'WSGAb5XwJ3Y';              // ANC - RMNCAH - Antenatal care registry\nlocal TRACKED_ENTITY_TYPE = 'MCPQUTHX1Ze';  // Person\nlocal STAGE = {\n  profile: 'iF5roNU7QWm',  // Woman's Profile and History (NON-repeatable)\n  exam: 'JqW7c9HYjVr',     // ANC Examination (repeatable)\n};\nlocal ATTRIBUTE = {\n  mrn: 'OYuDdqr2MvX',          // Client MRN (unique — the identity key)\n  dateOfBirth: 'Fgf497oYvSC',\n  phone: 'RJxLa3nITB3',        // SMS phone number\n};\nlocal DATA_ELEMENT = {\n  lnmp: 'w4ky6EkVahL',\n  edd: 'Ru01omP2WCQ',\n  gestationalAge: 'w9p8MQDRyMr',  // INTEGER_POSITIVE, sent only when the source sends it\n  gaSource: 'RPSgZF1i0hk',        // option set: Clinical | LMP | Ultrasound\n  visitNumber: 'bXVD2EMF7UW',     // ANC Visit Number — the event MERGE KEY\n};\n\n/* ---- helpers ------------------------------------------------------------- */\nlocal present(v) = v != null && v != '';\nlocal attribute(uid, value) = { attribute: uid, value: value };\nlocal dataValue(uid, value) = { dataElement: uid, value: value };\n\n/* ---- the record ----------------------------------------------------------- */\nlocal rec = body;\nlocal orgUnit = rec.facilityCode;\nlocal visits = std.sort(rec.visits, function(v) v.visitNumber);\nlocal lastVisit = visits[std.length(visits) - 1];\nlocal visitOnes = [v for v in visits if v.visitNumber == 1];\n\n/* enrollment anchor: the recorded first-visit date, else the earliest encounter */\nlocal enrolledAt = if present(rec.dateOfFirstVisit) then rec.dateOfFirstVisit\n                   else visits[0].encounterDate;\n\n/* ---- events ---------------------------------------------------------------- */\n/* Woman's Profile: one per pregnancy — built ONLY when this record carries\n   visit 1 (follow-up-only records leave the existing profile untouched). */\nlocal profileEvents = [\n  {\n    programStage: STAGE.profile,\n    orgUnit: orgUnit,\n    occurredAt: enrolledAt,\n    status: 'COMPLETED',\n    completedAt: enrolledAt,\n    /* GA is mapped VERBATIM when Bahmni sends it, omitted when it doesn't —\n       the mapping does no clinical arithmetic. Same for the source label:\n       it only makes sense alongside a GA value. */\n    dataValues:\n      [\n        dataValue(DATA_ELEMENT.lnmp, rec.lnmp),\n        dataValue(DATA_ELEMENT.edd, rec.edd),\n      ]\n      + (if present(v1.gestationalAge) then [\n           dataValue(DATA_ELEMENT.gestationalAge, v1.gestationalAge),\n           dataValue(DATA_ELEMENT.gaSource, 'LMP'),\n         ] else []),\n  }\n  for v1 in visitOnes\n];\n\n/* one exam event per encounter; the visit number is the merge key.\n   A visit captured in the source IS a completed contact — COMPLETED, dated\n   the day it happened. (Only the SCHEDULE placeholder below stays open: it is\n   what the overdue-visit tracking keys off.) */\nlocal examEvent(v) = {\n  programStage: STAGE.exam,\n  orgUnit: orgUnit,\n  occurredAt: v.encounterDate,\n  status: 'COMPLETED',\n  completedAt: v.encounterDate,\n  dataValues: [dataValue(DATA_ELEMENT.visitNumber, v.visitNumber)],\n};\n\n/* the next appointment: ONE SCHEDULE event from the LATEST visit's nextDate.\n   It carries NO data values — DHIS2 forbids them on SCHEDULE events (E1315) —\n   so it has no visit number. The merge instead claims the stage's open\n   SCHEDULE event when a real visit arrives: attendance fulfils the\n   appointment and the placeholder BECOMES the visit. */\nlocal scheduledEvents =\n  if present(lastVisit.nextDate) then [{\n    programStage: STAGE.exam,\n    orgUnit: orgUnit,\n    scheduledAt: lastVisit.nextDate,\n    status: 'SCHEDULE',\n  }] else [];\n\n/* ---- the tracker payload ---------------------------------------------------- */\n{\n  trackedEntities: [\n    {\n      trackedEntityType: TRACKED_ENTITY_TYPE,\n      orgUnit: orgUnit,\n      attributes: [\n        attribute(ATTRIBUTE.mrn, std.toString(rec.patientId)),\n        attribute(ATTRIBUTE.dateOfBirth, rec.birthDate),\n      ] + (\n        /* defensive: validation requires the phone, but never send a null value */\n        if present(rec.phoneNumber) then [attribute(ATTRIBUTE.phone, rec.phoneNumber)] else []\n      ),\n      enrollments: [\n        {\n          program: PROGRAM,\n          orgUnit: orgUnit,\n          enrolledAt: enrolledAt,\n          occurredAt: enrolledAt,\n          status: 'ACTIVE',\n          events: profileEvents + [examEvent(v) for v in visits] + scheduledEvents,\n        },\n      ],\n    },\n  ],\n}\n"
