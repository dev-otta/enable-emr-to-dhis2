# Copy this file to .env and fill in real values before running.
#   cp .env.example .env

# ---- Source registry (one strong key PER EMR SITE) ----------------------
# A source with a key EXISTS: it gets POST /api/<source>/anc-record and a
# security rule. A source with a blank key does not exist at all. Generate
# each key with:  openssl rand -hex 32
#
# POC focus: only PulseTech is enabled. The mediator refuses to start with no
# enabled source, with placeholder/short keys, or with two sources sharing a key.
MEDIATOR_API_KEY_PULSETECH=

# Enable the Bahmni pipeline (real reference contract — see emr-mocks/bahmni/)
# by setting its key. Required for `yarn push:bahmni`, `yarn push:bahmni-batch`
# and the full e2e suite; CI sets it.
MEDIATOR_API_KEY_BAHMNI=

# Additional sources need no code: any API_KEYS_<SOURCE> variable becomes a
# pipeline (plus its three datastore expressions — docs/REFERENCE.md §5).
# API_KEYS_OPENCLINIC=

# ---- DHIS2 credentials -------------------------------------------------
# The loaded dump (ENABLE ANC package) carries its own DHIS2 users. The seed
# container and the mediator must authenticate with an account THAT EXISTS in
# the dump. admin/district is only correct for the plain demo DB; set these to
# match the ENABLE dump (or reset a password after load).
SEED_DHIS2_USER=admin
SEED_DHIS2_PASSWORD=district

# Mediator's DHIS2 account (defaults to admin/district). For anything beyond a
# throwaway demo, create a least-privilege account (docs/REFERENCE.md §6) and set these.
# MEDIATOR_DHIS2_USERNAME=enable_mediator
# MEDIATOR_DHIS2_PASSWORD=

# ---- Guardrails (override per deployment) ------------
# MEDIATOR_MAX_REQUEST_BYTES=1048576       # 413 above this (single-record path)
# MEDIATOR_THROTTLE_MAX_REQUESTS=10        # 429 beyond this many...
# MEDIATOR_THROTTLE_PERIOD_MILLIS=1000     # ...per this period
# MEDIATOR_BATCH_MAX_RECORDS=1000          # entries per /anc-records request (400 above)
# MEDIATOR_BATCH_MAX_REQUEST_BYTES=20971520  # 413 above this on the batch path

# ---- TLS -----------------------------------------------------------------
# Demo default: self-signed keystore baked into the image. For real use,
# mount a proper keystore and point at it, or terminate TLS in a proxy in
# front and disable it here (docs/REFERENCE.md §6).
# MEDIATOR_TLS_ENABLED=true
# MEDIATOR_KEYSTORE_PATH=file:/certs/keystore.p12
# MEDIATOR_KEYSTORE_PASSWORD=changeit
# MEDIATOR_KEYSTORE_ALIAS=mediator

# ---- Optional: ports / image ------------------------------------------
# DHIS2 version is pinned to match the ENABLE test instance (2.41.5.1).
# If you change this, also load a matching DB dump (db-dump/README.md).
DHIS2_IMAGE=dhis2/core:2.41.5.1
DHIS2_PORT=8080
MEDIATOR_PORT=9070
